# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# The app needs ONLY these two variables to run.
# ─────────────────────────────────────────────────────────────────────────────

# From: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ─────────────────────────────────────────────────────────────────────────────
# Second Supabase project — product reviews & comments only.
# Create a separate Supabase project, run supabase_reviews.sql in its SQL
# Editor, then paste the URL and anon key here. Leave empty to fall back to
# the main project above (reviews will share the same database).
# ─────────────────────────────────────────────────────────────────────────────
VITE_REVIEWS_SUPABASE_URL=
VITE_REVIEWS_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets integration (optional — only needed for the sheets sync)
# These are stored as Supabase Edge Function secrets, NOT in this file.
# Set them via: Supabase Dashboard → Edge Functions → Secrets
#   GOOGLE_SERVICE_ACCOUNT_KEY = the full JSON of your service account key
#   GOOGLE_SHEET_ID             = the ID from your Google Sheet URL
# ─────────────────────────────────────────────────────────────────────────────
